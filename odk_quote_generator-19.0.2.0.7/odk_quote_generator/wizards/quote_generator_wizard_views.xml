<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Vue formulaire du wizard de generation de devis                     -->
    <!-- ================================================================== -->
    <record id="view_odk_quote_generator_wizard_form" model="ir.ui.view">
        <field name="name">odk.quote.generator.wizard.form</field>
        <field name="model">odk.quote.generator.wizard</field>
        <field name="arch" type="xml">
            <form string="Generateur de devis ODK">
                <sheet>
                    <div class="oe_title">
                        <h1>Generateur de devis ODK</h1>
                    </div>

                    <!-- Etape 1 : contexte commercial -->
                    <group string="1. Contexte commercial">
                        <group>
                            <field name="partner_id" options="{'no_create_edit': True}"/>
                            <field name="opportunity_id"
                                   options="{'no_create_edit': True}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <!-- Etape 2 : choix des offres a inclure -->
                    <group string="2. Offres a inclure dans le devis">
                        <group>
                            <field name="include_packs"/>
                        </group>
                        <group>
                            <field name="include_subscription"/>
                        </group>
                    </group>

                    <!-- Section Packs Factures -->
                    <group string="Packs Factures" invisible="not include_packs">
                        <group>
                            <field name="pk_grid_id"
                                   options="{'no_create_edit': True}"
                                   required="include_packs"/>
                            <field name="pk_engagement_months" widget="radio"
                                   readonly="not pk_grid_id"/>
                            <field name="volume_annuel"
                                   required="include_packs"
                                   help="Volume previsionnel annuel utilise pour selectionner le palier."/>
                        </group>
                        <group>
                            <field name="pk_tier_id" readonly="1" invisible="not pk_tier_id"/>
                            <field name="pk_expected_unit_price" readonly="1" invisible="not pk_tier_id"/>
                            <field name="pk_monthly_base" readonly="1" invisible="not pk_tier_id"/>
                        </group>
                    </group>

                    <!-- Section Abonnement ODK -->
                    <group string="Abonnement ODK" invisible="not include_subscription">
                        <group>
                            <field name="ab_grid_id"
                                   options="{'no_create_edit': True}"
                                   required="include_subscription"/>
                            <field name="ab_engagement_months" widget="radio"
                                   readonly="not ab_grid_id"/>
                            <field name="nb_shops" required="include_subscription"/>
                            <field name="pa_tierce"/>
                            <field name="nb_caisses"
                                   help="Laisser 0 pour utiliser le minimum inclus du palier."/>
                            <field name="tx_total"
                                   help="Laisser 0 pour utiliser le volume inclus du palier."/>
                        </group>
                        <group>
                            <field name="ab_tier_id" readonly="1" invisible="not ab_tier_id"/>
                            <field name="ab_expected_unit_price" readonly="1" invisible="not ab_tier_id"/>
                            <field name="ab_monthly_base" readonly="1" invisible="not ab_tier_id"/>
                            <field name="ab_monthly_overage_caisses" readonly="1"
                                   invisible="ab_monthly_overage_caisses == 0"/>
                            <field name="ab_monthly_overage_tx" readonly="1"
                                   invisible="ab_monthly_overage_tx == 0"/>
                            <field name="ab_monthly_surcharge_pa" readonly="1"
                                   invisible="not pa_tierce or ab_monthly_surcharge_pa == 0"/>
                            <field name="ab_monthly_total" readonly="1"
                                   invisible="not ab_tier_id"/>
                        </group>
                    </group>

                    <!-- Recapitulatif combine -->
                    <group string="Recapitulatif"
                           invisible="not pk_tier_id and not ab_tier_id">
                        <field name="monthly_total_combined" readonly="1"
                               class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_generate_quote"
                            type="object"
                            string="Generer le devis"
                            class="btn-primary"/>
                    <button string="Annuler"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ================================================================== -->
    <!-- Action d'ouverture du wizard                                        -->
    <!-- ================================================================== -->
    <record id="action_odk_quote_generator_wizard" model="ir.actions.act_window">
        <field name="name">Nouveau devis ODK</field>
        <field name="res_model">odk.quote.generator.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ================================================================== -->
    <!-- Menu : Nouveau devis (visible des commerciaux)                      -->
    <!-- ================================================================== -->
    <menuitem id="menu_odk_quote_generator_wizard"
              name="Nouveau devis"
              parent="menu_odk_quotes"
              action="action_odk_quote_generator_wizard"
              sequence="5"
              groups="odk_quote_generator.group_odk_commercial"/>

</odoo>
