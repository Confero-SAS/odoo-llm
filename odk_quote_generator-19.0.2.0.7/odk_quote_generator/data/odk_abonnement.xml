        <record id="tier_abo_paodk_xl" model="odk.pricing.tier">
            <field name="code">XL</field>
            <field name="libelle">Tres grand reseau (300 - 699 magasins)</field>
            <field name="sequence">50</field>
            <field name="grid_id" ref="grid_abo_pa_odk"/>
            <field name="shop_min">300</field>
            <field name="shop_max">699</field>
            <field name="caisses_included">5</field>
            <field name="tx_caisse_mois">12000</field>
