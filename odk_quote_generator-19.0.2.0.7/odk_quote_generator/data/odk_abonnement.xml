        </record>

        <record id="tier_abo_paodk_xxl" model="odk.pricing.tier">
            <field name="code">XXL</field>
            <field name="libelle">Pot commun (>= 700 magasins)</field>
            <field name="sequence">60</field>
            <field name="grid_id" ref="grid_abo_pa_odk"/>
