<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Bouton intelligent "Devis ODK" sur la fiche contact -->
    <record id="view_partner_form_odk" model="ir.ui.view">
        <field name="name">res.partner.form.odk</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_view_odk_quotes"
                        icon="fa-file-text-o"
                        invisible="odk_quote_count == 0"
                        groups="odk_quote_generator.group_odk_direction">
                    <field name="odk_quote_count" widget="statinfo"
                           string="Devis ODK"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
