<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================== -->
    <!-- Format papier A4 dedie aux devis ODK                                -->
    <!-- ================================================================== -->
    <record id="paperformat_odk_quote" model="report.paperformat">
        <field name="name">ODK Quote A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">22</field>
        <field name="dpi">90</field>
    </record>

    <!-- ================================================================== -->
    <!-- Action de rapport - PDF "Devis ODK"                                  -->
    <!-- ================================================================== -->
    <record id="action_report_odk_quote" model="ir.actions.report">
        <field name="name">Devis ODK</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odk_quote_generator.report_odk_quote_document</field>
        <field name="report_file">odk_quote_generator.report_odk_quote_document</field>
        <field name="paperformat_id" ref="paperformat_odk_quote"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Devis ODK - %s' % (object.name)</field>
        <field name="attachment_use" eval="False"/>
    </record>

</odoo>
